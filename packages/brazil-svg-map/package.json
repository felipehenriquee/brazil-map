{
  "name": "brazil-svg-map",
  "version": "0.1.0",
  "description": "Interactive SVG map of Brazil for React: regions, states and all 5,571 municipalities (IBGE 2025), loaded per state on demand.",
  "keywords": [
    "brazil",
    "brasil",
    "map",
    "svg",
    "react",
    "ibge",
    "states",
    "municipalities"
  ],
  "author": "Felipe Henrique Morais Araujo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipehenriquee/brazil-map.git",
    "directory": "packages/brazil-svg-map"
  },
  "homepage": "https://github.com/felipehenriquee/brazil-map/tree/main/packages/brazil-svg-map#readme",
  "bugs": {
    "url": "https://github.com/felipehenriquee/brazil-map/issues"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "d3-geo": "^3.1.1",
    "mapshaper": "^0.6.121",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
